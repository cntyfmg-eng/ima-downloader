{
  "manifest_version": 3,
  "name": "ima知识库下载器",
  "version": "1.2.0",
  "description": "在 ima 中直接浏览并下载知识库资料（网页转存/文档原格式/笔记TXT）— by 数智化教学大冯老师",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ima知识库下载器",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ima.qq.com/*",
        "https://ima-pre.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "downloader.html"
      ],
      "matches": [
        "https://ima.qq.com/*",
        "https://ima-pre.qq.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}